# Load these environment variables using your shell or service manager.
QOT_PORT=3211
QOT_DATA_DIR=./data
# Optional existing Hugging Face cache. Model files are read, never edited.
# QOT_HF_CACHE=/path/to/huggingface/cache
# Select a GPU by the UUID reported by nvidia-smi; do not assume index ordering.
CUDA_VISIBLE_DEVICES=GPU-225509c3-d702-6c27-de03-76b5e99b33b1
QOT_DEVICE=cuda:0
# Optional exact HTTPS reverse-proxy origin. Loopback remains available.
# QOT_PUBLIC_ORIGIN=https://operation-room.dimensionlab.net
